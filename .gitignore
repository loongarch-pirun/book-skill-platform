library/
library-backup-zh-small/
*.db
*.db-shm
*.db-wal

# 本地备份产物（由 npm run backup 生成，请定期拷到项目外）
backup/

# 运行日志
*.log

# 系统杂物
Thumbs.db
.DS_Store

# V3 第二波语料暂存区（公版/开放内容与本地素材，不上开源仓库）
books/_work/

# V3 第二波洗数据产物（任务书/结果含书库块文本的派生内容——私书洗过会落这里，整体隔离；入库后再从库侧看）
enrich-tasks/
enrich-results/
