# 依赖与构建产物
node_modules/
release/
release-new/

# 模型缓存（几百 MB，不入库）
.models/

# 书库二进制不入库（可由 books/ + embed-book.js 重建）；
# 但两个手工配置不可重建——随仓库走，保证新克隆与安装包行为一致
library/*
!library/usage-policy.json
!library/skill-state.json
library-backup-zh-small/
library-pre-p3/
library-new/
*.db
*.db-shm
*.db-wal

# 本地备份产物（由 npm run backup 生成，请定期拷到项目外）
backup/

# 运行日志
*.log

# 系统杂物
Thumbs.db
.DS_Store

# V3 第二波语料暂存区（公版/开放内容与本地素材，不上开源仓库）
books/_work/

# V3 第二波洗数据产物（任务书/结果含书库块文本的派生内容——私书洗过会落这里，整体隔离；入库后再从库侧看）
enrich-tasks/
enrich-results/

# 真实工作资料（隐私类，不跟踪；类工作资料放 books/_work/，真资料按流程放 own/ 后本地用）
books/皮润作业.docx
catalog-tasks/皮润作业.docx.json
# 本机一键启动脚本（路径本机化）
启动书库软件.cmd
