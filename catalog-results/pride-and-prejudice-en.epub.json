    },
    {
      "id": "t7",
      "name": "The Bennet Household",
      "note": "班内特家的家事：婚姻经济、母女张力与父亲的开明"
    },
    {
      "id": "t8",
      "name": "Meryton Society and the Militia",
      "note": "梅里顿的社交季与驻扎民团：舞会、闲话与军官们"
    },
    {
      "id": "t9",
      "name": "Pemberley and the Gardiners",
      "note": "彭伯利之行与嘉丁纳夫妇：伊丽莎白看见达西的另一面"
    },
    {
      "id": "t10",
      "name": "Colonel Fitzwilliam and the Bingley Circle",
      "note": "费茨威廉上校与宾利姐妹圈：赫斯特夫妇与卡罗琳的攀附"
