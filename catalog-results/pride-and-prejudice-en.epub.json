  "themes": [
    {
      "id": "t1",
      "name": "Elizabeth and Darcy",
      "note": "伊丽莎白与达西的感情线：从舞会偏见、求婚被拒到达西书信与终成眷属"
    },
    {
      "id": "t2",
      "name": "Jane and Bingley",
      "note": "简与宾利之恋：内瑟菲尔德舞会、宾利突然离开伦敦与破镜重圆"
    },
    {
      "id": "t3",
      "name": "Collins and Charlotte",
      "note": "柯林斯先生的求婚被拒与夏洛特·卢卡斯的现实婚姻"
    },
    {
      "id": "t4",
      "name": "Wickham's Deception",
      "note": "韦翰的虚伪：风流外表下的骗局与真相揭晓"
    },
    {
      "id": "t5",
      "name": "Lydia's Elopement",
      "note": "丽迪雅与韦翰私奔风波及达西的善后"
