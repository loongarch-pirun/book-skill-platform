    { "id": "t1", "name": "架构演进与微服务方法论", "note": "架构发展史、分布式八宗罪、微服务时代的拆分与协作方法论" },
    { "id": "t2", "name": "远程调用与 API 设计", "note": "REST/RPC 之争、RMM 成熟度、序列化与进程间通信开销" },
