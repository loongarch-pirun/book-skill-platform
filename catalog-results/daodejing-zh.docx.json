{
  "task_ref": "daodejing-zh.docx.db",
  "themes": [
    { "id": "t1", "name": "道體玄妙", "note": "道的形上描述：可道非常道、有無相生、無之用、道生一、道者萬物之奧" },
    { "id": "t2", "name": "無為而治", "note": "無為而無不為：太上貴言、天下神器不可為、為道日損、為之於未有" },
    { "id": "t3", "name": "上善若水與不爭", "note": "水善利萬物而不爭、江海為百谷王、不爭而善勝、柔弱勝剛強" },
    { "id": "t4", "name": "知足知止與保身", "note": "持而盈之不如其已、寵辱若驚、知足不辱、大成若缺、禍莫大於不知足" },
    { "id": "t5", "name": "聖人自處與玄德", "note": "聖人後身外身、抱一守雌、微妙玄通、知者不言、知不知尚矣" },
    { "id": "t6", "name": "養生攝生", "note": "谷神不死、專氣致柔、五色傷身、出生入死、含德之厚比於赤子" },
    { "id": "t7", "name": "治國與愛民", "note": "不尚賢、絕聖棄智、其政悶悶、治大國若烹小鮮、小邦寡民" },
    { "id": "t8", "name": "用兵與戒殺", "note": "兵者不祥之器、不以兵強天下、用兵有言不敢為主" },
    { "id": "t9", "name": "柔弱與權變", "note": "將欲歙之必固張之的微明之術、柔弱者生之徒" },
    { "id": "t10", "name": "天道與禍福", "note": "希言自然、飄風不終朝、反者道之動、天之道損有餘補不足" }
  ],
